#define Service_WimpCloseDown 0x53
#define Service_WimpRegisterFilters 0x86
#define Service_FilterManagerInstalled 0x87
#define Service_FilterManagerDying 0x88

static void announce(int started)
{
    if (started) {
        /* Service_FilterManagerInstalled (&87) */
        _swix(OS_ServiceCall, _IN(1), Service_FilterManagerInstalled);
    } else {
        /* Service_FilterManagerDying (&88) */
        _swix(OS_ServiceCall, _IN(1), Service_FilterManagerDying);
    }
}

/***************************************************************************
 * Function:     Mod_Init
 **************************************************************************/
_kernel_oserror *Mod_Init(const char *tail, int podule_base, void *pw)
{
    (void)tail;
    (void)podule_base;

    dprintf("Module FilterManager initialised\n");

    /* Schedule the 'Installed' announcement */
    _swix(OS_AddCallBack, _INR(0, 1), StartupCallback_Entry, pw);

    return NULL;
}


/***************************************************************************
 * Function:     Mod_Final
 **************************************************************************/
_kernel_oserror *Mod_Final(int fatal, int podule_base, void *pw)
{
    (void)fatal;
    (void)podule_base;

    dprintf("Module FilterManager dying\n");

    /* Remove any pending startup callback */
    _swix(OS_RemoveCallBack, _INR(0, 1), StartupCallback_Entry, pw);

    /* Announce we are dying BEFORE shutting down systems */
    announce(0);

    /* Release our filter handlers from the Wimp before freeing the lists
       they refer to, so that a stray call from the Wimp cannot land on
       memory we have already freed. */
    wimpfilter_release_all();

    filter_cleanup();

    return NULL;
}

/***************************************************************************
 * Function:     StartupCallback_Handler
 **************************************************************************/
_kernel_oserror *StartupCallback_Handler(_kernel_swi_regs *r, void *pw)
{
    (void)r;
    (void)pw;

    announce(1);
    return NULL;
}

/***************************************************************************
 * Function:     Mod_SWI
 **************************************************************************/
_kernel_oserror *Mod_SWI(int swi_no, _kernel_swi_regs *r, void *pw)
{
    switch (swi_no) {
        case Filter_RegisterPreFilter - Filter_00:
        {
            int was_empty = (global_state.pre_filters == NULL);
            _kernel_oserror *err = filter_register_pre((const char *)r->r[0], (void (*)(void))r->r[1], (void *)r->r[2], r->r[3]);
            if (!err && was_empty) {
                err = wimpfilter_register(WimpFilter_PrePoll, pw);
            }
            return err;
        }

        case Filter_RegisterPostFilter - Filter_00:
        {
            int was_empty = (global_state.post_filters == NULL);
            _kernel_oserror *err = filter_register_post((const char *)r->r[0], (void (*)(void))r->r[1], (void *)r->r[2], r->r[3], r->r[4]);
            if (!err && was_empty) {
                err = wimpfilter_register(WimpFilter_PostPoll, pw);
            }
            return err;
        }

        case Filter_DeRegisterPreFilter - Filter_00:
        {
            _kernel_oserror *err = filter_deregister_pre((const char *)r->r[0], (void (*)(void))r->r[1], (void *)r->r[2], r->r[3]);
            if (!err && global_state.pre_filters == NULL) {
                err = wimpfilter_deregister(WimpFilter_PrePoll);
            }
            return err;
        }

        case Filter_DeRegisterPostFilter - Filter_00:
        {
            _kernel_oserror *err = filter_deregister_post((const char *)r->r[0], (void (*)(void))r->r[1], (void *)r->r[2], r->r[3], r->r[4]);
            if (!err && global_state.post_filters == NULL) {
                err = wimpfilter_deregister(WimpFilter_PostPoll);
            }
            return err;
        }

        case Filter_RegisterRectFilter - Filter_00:
        {
            int was_empty = (global_state.rect_filters == NULL);
            _kernel_oserror *err = filter_register_rect((const char *)r->r[0], (void (*)(void))r->r[1], (void *)r->r[2], r->r[3]);
            if (!err && was_empty) {
                err = wimpfilter_register(WimpFilter_GetRectangle, pw);
            }
            return err;
        }

        case Filter_DeRegisterRectFilter - Filter_00:
        {
            _kernel_oserror *err = filter_deregister_rect((const char *)r->r[0], (void (*)(void))r->r[1], (void *)r->r[2], r->r[3]);
            if (!err && global_state.rect_filters == NULL) {
                err = wimpfilter_deregister(WimpFilter_GetRectangle);
            }
            return err;
        }

        case Filter_RegisterCopyFilter - Filter_00:
        {
            int was_empty = (global_state.copy_filters == NULL);
            _kernel_oserror *err = filter_register_copy((const char *)r->r[0], (void (*)(void))r->r[1], (void *)r->r[2]);
            if (!err && was_empty) {
                err = wimpfilter_register(WimpFilter_BlockCopy, pw);
            }
            return err;
        }

        case Filter_DeRegisterCopyFilter - Filter_00:
        {
            _kernel_oserror *err = filter_deregister_copy((const char *)r->r[0], (void (*)(void))r->r[1], (void *)r->r[2]);
            if (!err && global_state.copy_filters == NULL) {
                err = wimpfilter_deregister(WimpFilter_BlockCopy);
            }
            return err;
        }

        case Filter_RegisterPostRectFilter - Filter_00:
        {
            int was_empty = (global_state.post_rect_filters == NULL);
            _kernel_oserror *err = filter_register_post_rect((const char *)r->r[0], (void (*)(void))r->r[1], (void *)r->r[2], r->r[3]);
            if (!err && was_empty) {
                err = wimpfilter_register(WimpFilter_PostGetRectangle, pw);
            }
            return err;
        }

        case Filter_DeRegisterPostRectFilter - Filter_00:
        {
            _kernel_oserror *err = filter_deregister_post_rect((const char *)r->r[0], (void (*)(void))r->r[1], (void *)r->r[2], r->r[3]);
            if (!err && global_state.post_rect_filters == NULL) {
                err = wimpfilter_deregister(WimpFilter_PostGetRectangle);
            }
            return err;
        }

        case Filter_RegisterPostIconFilter - Filter_00:
        {
            int was_empty = (global_state.post_icon_filters == NULL);
            _kernel_oserror *err = filter_register_post_icon((const char *)r->r[0], (void (*)(void))r->r[1], (void *)r->r[2], r->r[3]);
            if (!err && was_empty) {
                err = wimpfilter_register(WimpFilter_PostIconGetRectangle, pw);
            }
            return err;
        }

        case Filter_DeRegisterPostIconFilter - Filter_00:
        {
            _kernel_oserror *err = filter_deregister_post_icon((const char *)r->r[0], (void (*)(void))r->r[1], (void *)r->r[2], r->r[3]);
            if (!err && global_state.post_icon_filters == NULL) {
                err = wimpfilter_deregister(WimpFilter_PostIconGetRectangle);
            }
            return err;
        }

        case Filter_RegisterIconBorderFilter - Filter_00:
        {
            int was_empty = (global_state.icon_border_filters == NULL);
            _kernel_oserror *err = filter_register_icon_border((const char *)r->r[0], (void (*)(void))r->r[1], (void *)r->r[2], r->r[3]);
            if (!err && was_empty) {
                err = wimpfilter_register(WimpFilter_IconBorder, pw);
            }
            return err;
        }

        case Filter_DeRegisterIconBorderFilter - Filter_00:
        {
            _kernel_oserror *err = filter_deregister_icon_border((const char *)r->r[0], (void (*)(void))r->r[1], (void *)r->r[2]);
            if (!err && global_state.icon_border_filters == NULL) {
                err = wimpfilter_deregister(WimpFilter_IconBorder);
            }
            return err;
        }

        default:
            return error_BAD_SWI;
    }
}

