/***************************************************************************
 * Function:     Mod_Service
 **************************************************************************/
void Mod_Service(int service_no, _kernel_swi_regs *r, void *pw)
{
    if (service_no == Service_WimpRegisterFilters) {
        /* The Wimp has started (or restarted) and wants filter handlers
           installed. Register any filter types we currently hold filters
           for - there is nothing to do for types with empty lists. */
        dprintf("Service_WimpRegisterFilters received\n");

        wimpfilter_service_register(pw);
        return;
    }

    if (service_no == Service_WimpCloseDown) {
        int task_handle;
        pre_filter_t *pre;
        post_filter_t *post;
        rect_filter_t *rect;
        post_rect_filter_t *prect;
        post_icon_filter_t *picon;

        task_handle = r->r[2];
        dprintf("WimpCloseDown for task %08X\n", task_handle);

        if (task_handle != 0) {
            pre = global_state.pre_filters;
            while (pre) {
                if (pre->task_handle == task_handle) {
                    filter_deregister_pre(pre->name, pre->routine, pre->r12, pre->task_handle);
                    pre = global_state.pre_filters;
                } else pre = pre->next;
            }
            if (global_state.pre_filters == NULL) {
                wimpfilter_deregister(WimpFilter_PrePoll);
            }

            post = global_state.post_filters;
            while (post) {
                if (post->task_handle == task_handle) {
                    filter_deregister_post(post->name, post->routine, post->r12, post->task_handle, post->event_mask);
                    post = global_state.post_filters;
                } else post = post->next;
            }
            if (global_state.post_filters == NULL) {
                wimpfilter_deregister(WimpFilter_PostPoll);
            }

            rect = global_state.rect_filters;
            while (rect) {
                if (rect->task_handle == task_handle) {
                    filter_deregister_rect(rect->name, rect->routine, rect->r12, rect->task_handle);
                    rect = global_state.rect_filters;
                } else rect = rect->next;
            }
            if (global_state.rect_filters == NULL) {
                wimpfilter_deregister(WimpFilter_GetRectangle);
            }

            prect = global_state.post_rect_filters;
            while (prect) {
                if (prect->task_handle == task_handle) {
                    filter_deregister_post_rect(prect->name, prect->routine, prect->r12, prect->task_handle);
                    prect = global_state.post_rect_filters;
                } else prect = prect->next;
            }
            if (global_state.post_rect_filters == NULL) {
                wimpfilter_deregister(WimpFilter_PostGetRectangle);
            }

            picon = global_state.post_icon_filters;
            while (picon) {
                if (picon->task_handle == task_handle) {
                    filter_deregister_post_icon(picon->name, picon->routine, picon->r12, picon->task_handle);
                    picon = global_state.post_icon_filters;
                } else picon = picon->next;
            }
            if (global_state.post_icon_filters == NULL) {
                wimpfilter_deregister(WimpFilter_PostIconGetRectangle);
            }
        }
    }
}
