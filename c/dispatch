/***************************************************************************
 * Function:     Filter_IconBorder_Handler
 * Description:  Called by the Wimp when an icon border requires
 *               rendering. Every registered icon border filter whose
 *               border_mask includes this border type (R0) is called;
 *               unlike the other filter types there is no task
 *               restriction and no "claim" protocol - all matching
 *               filters are called.
 *               Entry:  R9 = operation (see WimpFilter_IconBorder_*),
 *                       R0 = border type, R1 = icon flags,
 *                       R2 = bounding box (+dx/dy), R3 = colour table,
 *                       R4 = dithering flags / background colour.
 *               Exit:   all other registers preserved (except R12).
 **************************************************************************/
_kernel_oserror *Filter_IconBorder_Handler(_kernel_swi_regs *inregs, void *pw)
{
    _kernel_swi_regs10 *regs = (_kernel_swi_regs10 *)inregs; /* Actually the block passed is safely 12 regs long */
    icon_border_filter_t *filter;
    int mask_bit;

    (void)pw;

    /* border_mask bit set => filter DOES handle this border type */
    mask_bit = (regs->r[0] >= 0 && regs->r[0] <= 31) ? (1 << regs->r[0]) : 0;

    for (filter = global_state.icon_border_filters; filter; filter = filter->next) {
        if ((filter->border_mask & mask_bit) == 0) {
            continue;   /* Filter does not handle this border type */
        }

        _callx((void *)filter->routine, filter->r12,
               _INR(0, 9) | _OUTR(0, 9),
               regs->r[0], regs->r[1], regs->r[2], regs->r[3], regs->r[4],
               regs->r[5], regs->r[6], regs->r[7], regs->r[8], regs->r[9],
               &regs->r[0], &regs->r[1], &regs->r[2], &regs->r[3], &regs->r[4],
               &regs->r[5], &regs->r[6], &regs->r[7], &regs->r[8], &regs->r[9]);
    }

    return NULL;
}
