filter_state_t global_state = { NULL, NULL, NULL, NULL, NULL, NULL, NULL };

static char *my_strdup(const char *s)
{
    size_t len = strlen(s) + 1;
    char *new_s = malloc(len);
    if (new_s) {
        memcpy(new_s, s, len);
    }
    return new_s;
}

_kernel_oserror *filter_register_pre(const char *name, void (*routine)(void), void *r12, int task)
{
    pre_filter_t *curr;
    pre_filter_t *new_filter;

    curr = global_state.pre_filters;
    while (curr) {
        if (strcmp(curr->name, name) == 0 && curr->task_handle == task) {
            return Err_FilterAlreadyRegistered;
        }
        curr = curr->next;
    }

    new_filter = malloc(sizeof(pre_filter_t));
    if (!new_filter) {
        return Err_NoMoreRoomForFilters;
    }

    new_filter->name = my_strdup(name);
    if (!new_filter->name) {
        free(new_filter);
        return Err_NoMoreRoomForFilters;
    }

    new_filter->routine = routine;
    new_filter->r12 = r12;
    new_filter->task_handle = task;
    new_filter->next = global_state.pre_filters;
    global_state.pre_filters = new_filter;

    return NULL;
}

