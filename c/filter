_kernel_oserror *filter_deregister_pre(const char *name, void (*routine)(void), void *r12, int task)
{
    pre_filter_t *curr;
    pre_filter_t *prev = NULL;

    curr = global_state.pre_filters;
    while (curr) {
        if (strcmp(curr->name, name) == 0 && 
            curr->routine == routine && 
            curr->r12 == r12 && 
            curr->task_handle == task) {
            
            if (prev) {
                prev->next = curr->next;
            } else {
                global_state.pre_filters = curr->next;
            }
            free(curr->name);
            free(curr);
            return NULL;
        }
        prev = curr;
        curr = curr->next;
    }

    return Err_FilterNotRegistered;
}

