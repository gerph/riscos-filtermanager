void filter_cleanup(void)
{
    pre_filter_t *pre;
    post_filter_t *post;
    rect_filter_t *rect;
    copy_filter_t *copy;
    post_rect_filter_t *prect;
    post_icon_filter_t *picon;
    icon_border_filter_t *iborder;

    pre = global_state.pre_filters;
    while (pre) {
        pre_filter_t *next = pre->next;
        free(pre->name);
        free(pre);
        pre = next;
    }
    global_state.pre_filters = NULL;

    post = global_state.post_filters;
    while (post) {
        post_filter_t *next = post->next;
        free(post->name);
        free(post);
        post = next;
    }
    global_state.post_filters = NULL;

    rect = global_state.rect_filters;
    while (rect) {
        rect_filter_t *next = rect->next;
        free(rect->name);
        free(rect);
        rect = next;
    }
    global_state.rect_filters = NULL;

    copy = global_state.copy_filters;
    while (copy) {
        copy_filter_t *next = copy->next;
        free(copy->name);
        free(copy);
        copy = next;
    }
    global_state.copy_filters = NULL;

    prect = global_state.post_rect_filters;
    while (prect) {
        post_rect_filter_t *next = prect->next;
        free(prect->name);
        free(prect);
        prect = next;
    }
    global_state.post_rect_filters = NULL;

    picon = global_state.post_icon_filters;
    while (picon) {
        post_icon_filter_t *next = picon->next;
        free(picon->name);
        free(picon);
        picon = next;
    }
    global_state.post_icon_filters = NULL;

    iborder = global_state.icon_border_filters;
    while (iborder) {
        icon_border_filter_t *next = iborder->next;
        /* Don't free iborder->name as it's static */
        free(iborder);
        iborder = next;
    }
    global_state.icon_border_filters = NULL;
}

void filter_list(void)
{
    pre_filter_t *pre = global_state.pre_filters;
    post_filter_t *post = global_state.post_filters;
    rect_filter_t *rect = global_state.rect_filters;
    copy_filter_t *copy = global_state.copy_filters;
    post_rect_filter_t *prect = global_state.post_rect_filters;
    post_icon_filter_t *picon = global_state.post_icon_filters;
    icon_border_filter_t *iborder = global_state.icon_border_filters;

    printf("Pre-filters:\n");
    if (!pre) printf("  None\n");
    else {
        printf("  %-20s %-8s %-8s %-8s\n", "Name", "Routine", "R12", "Task");
        while (pre) {
            printf("  %-20s %08X %08X %08X\n", pre->name, (unsigned int)pre->routine, (unsigned int)pre->r12, pre->task_handle);
